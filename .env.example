# 国内线路直连 *.supabase.co 会被 SNI 阻断，用自定义域名反代（见 supabase-proxy/）
NEXT_PUBLIC_SUPABASE_URL=https://api.yinleilei.cn
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...

# ---- 阿里云 OSS（文件存储）-------------------------------------------------
NEXT_PUBLIC_OSS_REGION=
NEXT_PUBLIC_OSS_BUCKET=
NEXT_PUBLIC_OSS_ENDPOINT=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_STS_ROLE_ARN=

# ---- Unsplash（登录/注册页的背景墙）----------------------------------------
# Server-only。留空时登录/注册页改用内置的那组固定图片，页面照常渲染。
UNSPLASH_ACCESS_KEY=
